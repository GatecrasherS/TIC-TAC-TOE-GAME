#include <iostream>

using namespace std;

// Global 2D array representation of the 3x3 game board

char board[3][3] = { {'1', '2', '3'},
                     {'4', '5', '6'},
                     {'7', '8', '9'} };

char current_marker;
int current_player;

// Function to print the current state of the board in a clean terminal layout

void drawBoard() {
    cout << "\n";
    cout << " " << board[0][0] << " | " << board[0][1] << " | " << board[0][2] << " \n";
    cout << "---|---|---\n";
    cout << " " << board[1][0] << " | " << board[1][1] << " | " << board[1][2] << " \n";
    cout << "---|---|---\n";
    cout << " " << board[2][0] << " | " << board[2][1] << " | " << board[2][2] << " \n";
    cout << "\n";
}

// Function to place a marker at the chosen cell slot (1-9)

bool placeMarker(int slot) {

    // Map the single-digit slot index directly to 2D array row and column indexes

    int row = (slot - 1) / 3;
    int col = (slot - 1) % 3;

    // Check if the cell slot is already occupied by 'X' or 'O'

    if (board[row][col] != 'X' && board[row][col] != 'O') {
        board[row][col] = current_marker;
        return true; // Mark placement was successful
    }
    
    return false; 
// Since the Slot was occupied, invalid move
}

// Function to evaluate if a player has won the game

int checkWinner() {
//WE WILL CHECK ALL POSSIBLE COMBINATIONS OF WINNING, i.e. ROWS, COLUMNS AND DIGONALS
    // 1. Check rows for consecutive markers

    for (int i = 0; i < 3; i++) {
        if (board[i][0] == board[i][1] && board[i][1] == board[i][2]) {
            return current_player;
        }
    }

    // 2. Check columns for consecutive markers

    for (int i = 0; i < 3; i++) {
        if (board[0][i] == board[1][i] && board[1][i] == board[2][i]) {
            return current_player;
        }
    }

    // 3. Check primary diagonal matrix items

    if (board[0][0] == board[1][1] && board[1][1] == board[2][2]) {
        return current_player;
    }

    // 4. Check secondary diagonal matrix items

    if (board[0][2] == board[1][1] && board[1][1] == board[2][0]) {
        return current_player;
    }

    return 0; // No winner found yet
}

// Alternates players and their corresponding active markers
void switchPlayer() {
    if (current_marker == 'X') {
        current_marker = 'O';
        current_player = 2;
    } else {
        current_marker = 'X';
        current_player = 1;
    }
}

// The structural execution loop for managing game states
void gameEngine() {
    cout << "Player 1, choose your marker (X or O): ";
    cin >> current_marker;

    // Enforce proper conditional input tracking
    while (current_marker != 'X' && current_marker != 'O') {
        cout << "Invalid marker! Please select either X or O: ";
        cin >> current_marker;
    }

    current_player = (current_marker == 'X') ? 1 : 2;

    drawBoard();
    int player_won = 0;

    // A standard 3x3 grid game ends in maximum 9 valid turns
    for (int turn = 0; turn < 9; turn++) {
        int slot;
        cout << "Player " << current_player << "'s turn (" << current_marker << "). Enter slot (1-9): ";
        cin >> slot;

        // Validate Limits and Place the movement restrictions

        if (slot < 1 || slot > 9 || !placeMarker(slot)) {
            cout << "Invalid move slot! Please Try again.\n";
            turn--; // Decrement the loop iteration count to re-run the same turn safely
            continue;
        }

        drawBoard();
        
        // Run look-up evaluation logic loops instantly after every turn update
        player_won = checkWinner();

        if (player_won != 0) {
            cout << "Congratulations! Player " << player_won << " wins the match!\n";
            break;
        }

        switchPlayer();
    }

    if (player_won == 0) {
        cout << "The game is a tie! Well played.\n";
    }
}

int main() {
    cout << " Welcome to Tic-Tac-Toe Game Engine!\n";
    gameEngine();
    return 0;
}
